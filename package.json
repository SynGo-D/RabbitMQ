{
  "dependencies": {
    "amqplib": "^2.0.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.7",
    "typescript": "^5.9.2"
  },
  "name": "rabbitmq",
  "version": "1.0.0",
  "type": "module",
  "description": "RabbitMQ communication service for SynGo-D backend microservices",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "node --import tsx --test src/**/*.test.ts",
    "test:unit": "node --import tsx --test src/**/*.test.ts --grep '^(?!Integration|E2E)'",
    "test:integration": "node --import tsx --test src/rabbitmq/integration.test.ts",
    "test:e2e": "node --import tsx --test --test-concurrency=1 src/e2e.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SynGo-D/RabbitMQ.git"
  },
  "keywords": [],
